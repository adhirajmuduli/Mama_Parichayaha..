# Server-only delivery and abuse controls. Never commit real values.
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_ALLOWED_ORIGINS=

# Public Turnstile widget key. This may be exposed to browsers.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Operational controls. CONTACT_DELIVERY_ENABLED=false is an immediate fail-closed contact switch.
CONTACT_DELIVERY_ENABLED=true
ENABLE_HSTS=false

# Used only by npm run deploy:smoke. Never place credentials here.
DEPLOYMENT_URL=
SMOKE_EXPECT_CONTACT=false
SMOKE_EXPECT_HSTS=false

# Canonical site origin used for metadata/robots/sitemap (empty = deployed default).
NEXT_PUBLIC_SITE_URL=

# Feature switches (booleans; invalid or missing values fall back to defaults).
# Animated ASCII playback: off until the owner's animation sources land.
NEXT_PUBLIC_FEATURE_EXHIBITS=false
# Optional canvas2D dust background (measure before enabling).
NEXT_PUBLIC_FEATURE_DUST=false
# Light spring cursor blob (immersive mode, fine pointers only).
NEXT_PUBLIC_FEATURE_CURSOR_BLOB=true
# Lanyard island in the origins slot (lazy chunk, desktop-class devices).
NEXT_PUBLIC_FEATURE_LANYARD=true
# Diagnostics overlay + window snapshot hook (default: development only).
# NEXT_PUBLIC_FEATURE_DIAGNOSTICS=true
