{
  "name": "bio-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start:standalone": "npm run prepare:standalone && node scripts/start-standalone.mjs",
    "deploy:smoke": "node scripts/post-deploy-smoke.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/check-server-client-boundaries.mjs",
    "links:check": "node scripts/check-public-links.mjs",
    "unit": "vitest run",
    "coverage": "vitest run --coverage",
    "contact:security": "vitest run tests/unit/contact-contract.test.ts tests/unit/contact-security.test.ts",
    "e2e": "npm run build && playwright test tests/e2e/portfolio.spec.ts tests/e2e/accessibility.spec.ts tests/e2e/model-interaction.spec.ts tests/e2e/contact.spec.ts tests/e2e/seo.spec.ts tests/e2e/scene-resilience.spec.ts tests/e2e/performance.spec.ts --workers=1",
    "accessibility": "npm run e2e -- tests/e2e/accessibility.spec.ts",
    "test:performance": "npm run build && playwright test tests/e2e/performance.spec.ts --project=desktop --workers=1",
    "bundle": "npm run build && node scripts/check-bundle-budget.mjs",
    "bundle:analyze": "node scripts/build-bundle.mjs",
    "knip": "node scripts/run-knip.mjs",
    "security": "npm audit --omit=dev --audit-level=high",
    "asset:inspect": "npm run asset:audit && gltf-transform inspect public/models/dna_for_site.glb",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run boundaries && npm run links:check && npm run unit && npm run coverage && npm run knip && npm run asset:inspect && npm run bundle",
    "lighthouse:ci": "npx --yes @lhci/cli@0.15.1 autorun",
    "licenses:inventory": "node scripts/license-inventory.mjs",
    "asset:verify": "node scripts/verify-model-assets.mjs",
    "asset:audit": "npm run asset:verify && node scripts/audit-scene-assets.mjs",
    "asset:optimize": "node scripts/optimize-scene-asset.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "clsx": "^2.1.1",
    "motion": "12.42.0",
    "next": "15.5.24",
    "postprocessing": "^6.37.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.176.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "^3",
    "@gltf-transform/cli": "^4.4.1",
    "@next/bundle-analyzer": "15.5.24",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.1.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "knip": "6.27.0",
    "prettier": "3.9.4",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.17.0 <23",
    "npm": ">=10.9.2 <12"
  },
  "packageManager": "npm@11.4.2",
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
